{
  "name": "@watchtowerobservability/electron",
  "version": "0.2.0",
  "repository": { "type": "git", "url": "git+https://github.com/watchtowerobservability/watchtower-electron.git" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Watchtower SDK for Electron: main and renderer errors, native crash minidumps, offline queue (TypeScript)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./preload": { "types": "./dist/preload.d.ts", "default": "./dist/preload.js" }
  },
  "license": "Apache-2.0",
  "engines": { "node": ">=18" },
  "peerDependencies": { "electron": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "typescript": "5.7.2",
    "vitest": "5.0.5"
  }
}
